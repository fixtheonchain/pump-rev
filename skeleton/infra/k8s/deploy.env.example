# Copy to ignored .local/deploy.env; renderer reads only workspace-local files.
# All empty deployment values are deliberate configuration points, not defaults.
PUMPSKEL_APP_ENV_FILE=.local/deploy-app.env
IMAGE_REGISTRY=
IMAGE_TAG=
PUMPSKEL_RELEASE=
PUMPSKEL_IMAGE_PULL_POLICY=IfNotPresent
# Optional pre-created ECR image-pull Secret; EKS node/ECR IAM can supply pull access instead.
PUMPSKEL_IMAGE_PULL_SECRET=
AWS_ACM_CERTIFICATE_ARN=
AWS_SERVICE_ROLE_ARN=
# Optional per-service/job role ARN overrides: object keyed by catalog/job name.
PUMPSKEL_SERVICE_ROLES_JSON={}
AWS_ALB_SCHEME=internet-facing
AWS_ALB_SSL_POLICY=
AWS_ALB_IDLE_TIMEOUT_SECONDS=
PUMPSKEL_BFF_HOST=
PUMPSKEL_KEYED_HOST=
PUMPSKEL_DATABASE_URL=
PUMPSKEL_CLICKHOUSE_URL=
PUMPSKEL_CLICKHOUSE_USER=
PUMPSKEL_CLICKHOUSE_PASSWORD=
PUMPSKEL_REDIS_URL=
# Explicit single-replica research layout. Live Geyser stays disabled until its inputs are supplied.
PUMPSKEL_REPLICAS_JSON={"client-server":1,"keyed-api":1,"stream-gateway":1,"trading":1,"communities":1,"coins":1,"tx-builder":1,"limit":1,"profile":1,"notify":1,"live":1,"bridge":1,"auth-callout":1,"holder-rewards":1,"ingest":0}
# Populate every request and limit; the renderer rejects empty resource budgets.
PUMPSKEL_RESOURCES_JSON={"client-server":{"requests":{"cpu":"","memory":""},"limits":{"cpu":"","memory":""}},"keyed-api":{"requests":{"cpu":"","memory":""},"limits":{"cpu":"","memory":""}},"stream-gateway":{"requests":{"cpu":"","memory":""},"limits":{"cpu":"","memory":""}},"trading":{"requests":{"cpu":"","memory":""},"limits":{"cpu":"","memory":""}},"communities":{"requests":{"cpu":"","memory":""},"limits":{"cpu":"","memory":""}},"coins":{"requests":{"cpu":"","memory":""},"limits":{"cpu":"","memory":""}},"tx-builder":{"requests":{"cpu":"","memory":""},"limits":{"cpu":"","memory":""}},"limit":{"requests":{"cpu":"","memory":""},"limits":{"cpu":"","memory":""}},"profile":{"requests":{"cpu":"","memory":""},"limits":{"cpu":"","memory":""}},"notify":{"requests":{"cpu":"","memory":""},"limits":{"cpu":"","memory":""}},"live":{"requests":{"cpu":"","memory":""},"limits":{"cpu":"","memory":""}},"bridge":{"requests":{"cpu":"","memory":""},"limits":{"cpu":"","memory":""}},"auth-callout":{"requests":{"cpu":"","memory":""},"limits":{"cpu":"","memory":""}},"holder-rewards":{"requests":{"cpu":"","memory":""},"limits":{"cpu":"","memory":""}},"ingest":{"requests":{"cpu":"","memory":""},"limits":{"cpu":"","memory":""}},"migrate":{"requests":{"cpu":"","memory":""},"limits":{"cpu":"","memory":""}},"provision-bus":{"requests":{"cpu":"","memory":""},"limits":{"cpu":"","memory":""}},"replay-fixture":{"requests":{"cpu":"","memory":""},"limits":{"cpu":"","memory":""}},"nats":{"requests":{"cpu":"","memory":""},"limits":{"cpu":"","memory":""}}}
PUMPSKEL_PROBES_JSON={"periodSeconds":"","timeoutSeconds":"","failureThreshold":"","startupFailureThreshold":"","terminationGracePeriodSeconds":""}
PUMPSKEL_HEALTHCHECK_TIMEOUT_MS=
PUMPSKEL_JOB_BACKOFF_LIMIT=
# embedded: private NATS StatefulSet; external: existing, equally configured broker.
PUMPSKEL_NATS_MODE=embedded
PUMPSKEL_NATS_URL=
PUMPSKEL_NATS_PUBLIC_URL=
PUMPSKEL_NATS_CLIENTS_FILE=.local/nats/clients.json
PUMPSKEL_NATS_ISSUER_FILE=.local/nats/issuer.seed
PUMPSKEL_NATS_CURVE_FILE=.local/nats/curve.seed
PUMPSKEL_NATS_SERVER_CONFIG_FILE=.local/nats/server.conf
PUMPSKEL_STORAGE_CLASS=
PUMPSKEL_NATS_STORAGE_SIZE=
# Required only when ingest replicas > 0; endpoint/token remain Secrets.
PUMPSKEL_GEYSER_ENDPOINT=
PUMPSKEL_GEYSER_TOKEN=
PUMPSKEL_GEYSER_QUEUE_CAPACITY=
PUMPSKEL_GEYSER_MAX_FRAME_BYTES=
PUMPSKEL_HOLDER_SIGNER_FILE=
PUMPSKEL_INGEST_METADATA_FILE=
